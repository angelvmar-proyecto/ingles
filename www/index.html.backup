<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#0f0f1e">
<title>Oído Inglés</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;font-family:-apple-system,system-ui,sans-serif}
body{background:#0f0f1e;color:#f0f0f5;min-height:100vh;overflow-x:hidden;padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}
#app{max-width:520px;margin:0 auto;padding:16px;padding-bottom:100px}
h1{font-size:28px;font-weight:800}
h3{font-size:17px;font-weight:600;color:#a0a0b5}
p{color:#a0a0b5;font-size:14px;line-height:1.5}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
.header{display:flex;justify-content:space-between;align-items:center;padding:12px 0 20px}
.stats{display:flex;gap:8px;font-size:13px;font-weight:600}
.pill{background:#1a1a2e;padding:6px 12px;border-radius:20px;border:1px solid #2a2a45}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}
.card{background:#1a1a2e;border-radius:20px;padding:18px;border:1px solid #2a2a45;transition:.15s}
.card:active{transform:scale(.97)}
.card .emoji{font-size:32px;display:block;margin-bottom:8px}
.card .name{font-weight:700;font-size:15px;margin-bottom:2px}
.card .sub{font-size:12px;color:#7a7a95}
.bar{height:3px;background:#2a2a45;border-radius:3px;margin-top:10px;overflow:hidden}
.bar div{height:100%;background:linear-gradient(90deg,#7B68EE,#4A90E2);transition:.3s}
.back{display:flex;align-items:center;gap:8px;padding:8px 0;font-size:15px;color:#a0a0b5;font-weight:600}
.level-row{background:#1a1a2e;border-radius:16px;padding:16px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;border:1px solid #2a2a45}
.stars{font-size:16px;letter-spacing:2px;color:#F59E0B}
.learn-box{background:#1a1a2e;border-radius:24px;padding:40px 24px;text-align:center;border:1px solid #2a2a45;margin-top:16px}
.big-emoji{font-size:80px;display:block;margin-bottom:20px}
.word-en{font-size:38px;font-weight:800;margin-bottom:8px}
.word-es{font-size:20px;color:#a0a0b5;margin-bottom:28px}
.speak-btn{background:linear-gradient(135deg,#7B68EE,#4A90E2);border-radius:50%;width:80px;height:80px;font-size:32px;margin:0 auto;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(123,104,238,.4)}
.speak-btn:active{transform:scale(.92)}
.btn{background:linear-gradient(135deg,#7B68EE,#4A90E2);border-radius:16px;padding:18px;font-size:17px;font-weight:700;width:100%;margin-top:16px;color:white}
.btn-ghost{background:#1a1a2e;border:1px solid #2a2a45}
.option{background:#1a1a2e;border:2px solid #2a2a45;border-radius:16px;padding:20px;font-size:17px;font-weight:600;text-align:center;margin-bottom:10px;width:100%;color:white}
.option.correct{background:rgba(74,222,128,.15);border-color:#4ade80;color:#4ade80}
.option.wrong{background:rgba(248,113,113,.15);border-color:#f87171;color:#f87171}
.q-progress{display:flex;gap:4px;margin-bottom:20px}
.q-progress div{flex:1;height:6px;background:#2a2a45;border-radius:3px}
.q-progress div.done{background:#7B68EE}
.q-progress div.correct{background:#4ade80}
.q-progress div.wrong{background:#f87171}
.tip{background:rgba(123,104,238,.1);border:1px solid rgba(123,104,238,.3);border-radius:14px;padding:14px;font-size:13px;color:#c0b5ff;margin-top:16px;line-height:1.5}
.result{text-align:center;padding:40px 20px}
.result .big{font-size:72px;margin-bottom:16px}
.confetti{position:fixed;top:-20px;font-size:24px;animation:fall 3s linear forwards;pointer-events:none;z-index:100}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:0}}
.fade{animation:fade .3s ease}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.toggle{display:flex;gap:8px;background:#1a1a2e;padding:4px;border-radius:14px;border:1px solid #2a2a45}
.toggle button{padding:8px 14px;border-radius:10px;font-size:13px;font-weight:600;color:#7a7a95}
.toggle button.active{background:#7B68EE;color:white}
input[type=text]{width:100%;background:#1a1a2e;border:2px solid #2a2a45;border-radius:16px;padding:20px;font-size:20px;color:white;text-align:center;outline:none;font-weight:600}
.game-screen h1{text-align:center;color:#7dff7d;text-shadow:0 0 12px rgba(125,255,125,.6)}
.game-box{background:#0a1a0a;border:3px solid #3dd13d;border-radius:20px;padding:12px;margin:16px 0;box-shadow:0 0 30px rgba(61,209,61,.25)}
#snakeCanvas{width:100%;display:block;background:#0a3d0a;border-radius:14px;touch-action:manipulation}
.dpad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px;max-width:230px;margin-left:auto;margin-right:auto}
.dpad button{background:#1a3d1a;border:2px solid #3dd13d;color:#7dff7d;font-size:26px;padding:14px 0;border-radius:12px;font-weight:900}
.dpad button:active{background:#3dd13d;color:#0a3d0a;transform:scale(.94)}
.dpad .empty{visibility:hidden;pointer-events:none}
.quiz-summary{text-align:center;color:#a0a0b5;font-size:14px;margin-bottom:8px}
.quiz-summary b{color:#7dff7d}
</style>
</head>
<body>
<div id="app"></div>
<script>

function normalizeData(D){
  for(const mod of Object.values(D)){
    if(!mod.levels) continue;
    for(const lvl of mod.levels){
      if(!lvl.items) continue;
      lvl.items=lvl.items.map(it=>{
        if(Array.isArray(it)){
          const o={en:it[0],es:it[1]};
          if(it[2])o.emoji=it[2];
          return o;
        }
        if(it.a&&Array.isArray(it.a))it.a={en:it.a[0],es:it.a[1]};
        if(it.b&&Array.isArray(it.b))it.b={en:it.b[0],es:it.b[1]};
        return it;
      });
    }
  }
  return D;
}

